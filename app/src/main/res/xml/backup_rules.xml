<?xml version="1.0" encoding="utf-8"?>
<!--
   Financial data is sensitive: exclude the Room database and DataStore
   preferences from Android auto-backup so balances/transactions never
   leave the device via cloud backup.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore" />
</full-backup-content>
